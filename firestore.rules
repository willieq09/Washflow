rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required)
    //   - name: string (required)
    //   - email: string (required)
    //   - role: string (owner|worker) (required)
    //   - photoUrl: string (optional)
    //   - createdAt: timestamp (required)
    //
    // Collection: washes
    // Document ID: {id}
    // Fields:
    //   - workerId: string (required)
    //   - workerName: string (optional)
    //   - carModel: string (optional)
    //   - plateNumber: string (optional)
    //   - price: number (required, positive)
    //   - timestamp: timestamp (required)
    //   - status: string (completed) (required)
    //   - rating: number (optional, 1-5)
    //   - review: string (optional, max 500 chars)
    //   - maintenanceTip: string (optional)
    //
    // Collection: incentives
    // Document ID: {id}
    // Fields:
    //   - workerId: string (required)
    //   - washId: string (optional)
    //   - amount: number (required, positive)
    //   - reason: string (required)
    //   - timestamp: timestamp (required)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAppOwner() {
      return isAuthenticated() && 
             (getUserRole() == 'owner' || getUserRole() == 'admin' ||
              (request.auth.token.email == 'oumawillis09@gmail.com' && request.auth.token.email_verified == true));
    }

    function isWorker() {
      return isAuthenticated() && getUserRole() == 'worker';
    }

    function isCustomer() {
      return isAuthenticated() && getUserRole() == 'customer';
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
             data.uid is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string &&
             data.role in ['owner', 'worker', 'customer', 'admin'];
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'businessId', 'slot', 'status']) &&
             data.userId is string &&
             data.businessId is string &&
             data.status in ['pending', 'confirmed', 'completed', 'canceled'];
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAppOwner() || isWorker());
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(incoming());
      allow update: if isAuthenticated() && (isOwner(userId) || isAppOwner()) && isValidUser(incoming());
    }

    match /vehicles/{id} {
      allow read: if isAuthenticated() && (isOwner(incoming().userId) || isOwner(existing().userId) || isAppOwner());
      allow create: if isAuthenticated() && isOwner(incoming().userId);
      allow update, delete: if isAuthenticated() && (isOwner(existing().userId) || isAppOwner());
    }

    match /wash_businesses/{id} {
      allow read: if true;
      allow write: if isAppOwner();
    }

    match /bookings/{id} {
      allow read: if isAuthenticated() && (isOwner(existing().userId) || isAppOwner() || isWorker());
      allow create: if isAuthenticated() && isOwner(incoming().userId) && isValidBooking(incoming());
      allow update: if isAuthenticated() && (
        isAppOwner() || 
        isWorker() || 
        (isOwner(existing().userId) && incoming().status == 'canceled' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      );
    }

    match /washes/{washId} {
      allow read: if isAuthenticated() && (resource.data.workerId == request.auth.uid || isAppOwner() || isCustomer());
      allow create: if isAuthenticated() && (isWorker() || isAppOwner());
      allow update: if isAuthenticated() && (isAppOwner() || resource.data.workerId == request.auth.uid);
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(incoming().userId);
    }

    match /subscriptions/{id} {
      allow read: if isAuthenticated() && (isOwner(existing().userId) || isAppOwner());
      allow write: if isAppOwner();
    }

    match /plans/{id} {
      allow read: if true;
      allow write: if isAppOwner();
    }

    match /incentives/{id} {
      allow read: if isAuthenticated() && (resource.data.workerId == request.auth.uid || isAppOwner());
      allow create: if isAppOwner();
      allow delete: if isAppOwner();
    }
  }
}
