rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Auth tokens never contain custom claims. Look up roles from the DB.
    // Caution: get() inside list queries counts towards the 10-read limit per request.
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserRole() == 'admin' || 
        (request.auth.token.email == 'oumawillis09@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isStationOwner() {
      return isSignedIn() && getUserRole() == 'owner';
    }

    function isWorker() {
      return isSignedIn() && getUserRole() == 'worker';
    }

    function isCustomer() {
      return isSignedIn() && getUserRole() == 'customer';
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() > 0 &&
             data.role in ['owner', 'worker', 'customer', 'admin'] &&
             (data.createdAt == request.time || data.createdAt.toMillis() > 0) &&
             (!('vehicles' in data) || data.vehicles is list);
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'businessId', 'slot', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.businessId is string &&
             data.slot is timestamp &&
             data.status in ['pending', 'confirmed', 'completed', 'canceled'] &&
             (data.createdAt == request.time || data.createdAt.toMillis() > 0);
    }


    // --- Match Blocks ---

    // Initial connection test
    match /test/{id} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isWorker() || isStationOwner() || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && 
                    // Protect immutable fields
                    incoming().uid == existing().uid &&
                    incoming().role == existing().role &&
                    isValidUser(incoming());
    }


    match /wash_businesses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{id} {
      allow read: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow write: if isAdmin();
    }

    match /bookings/{id} {
      // Identity isolation
      allow read: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isOwner(resource.data.workerId) ||
        isWorker() || 
        isStationOwner() || 
        isAdmin()
      );
      
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidBooking(incoming());
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isWorker() && incoming().status == 'completed' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'workerId'])) ||
        (isOwner(existing().userId) && incoming().status == 'canceled' && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        (isStationOwner() && (get(/databases/$(database)/documents/wash_businesses/$(existing().businessId)).data.ownerId == request.auth.uid))
      );
      
      allow delete: if isAdmin();
    }

    match /washes/{id} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.workerId) || 
        isAdmin() || 
        isStationOwner() || 
        isWorker() ||
        isCustomer()
      );
      allow create: if isSignedIn() && (isWorker() || isStationOwner() || isAdmin());
      allow update: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isAdmin();
    }

    match /incentives/{id} {
      // Allow workers to see their own incentives, and station owners/admins to see all for reports
      allow read: if isSignedIn() && (isOwner(resource.data.workerId) || isStationOwner() || isAdmin());
      // For MVP, allow workers to log their own job incentives as triggered in App.tsx
      allow create: if isSignedIn() && (isWorker() || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
