rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Auth tokens never contain custom claims. Look up roles from the DB.
    // Caution: get() inside list queries counts towards the 10-read limit per request.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' || 
        (request.auth.token.email in ['oumawillis09@gmail.com', 'autoluxadmin02@gmail.com'] && request.auth.token.email_verified == true)
      );
    }

    function isStationOwner() {
      return isSignedIn() && getUserData().role == 'owner';
    }

    function isWorker() {
      return isSignedIn() && getUserData().role == 'worker';
    }

    function isStationMember(stationId) {
      return isSignedIn() && (
        request.auth.uid == stationId ||
        getUserData().stationId == stationId
      );
    }

    function isCustomer() {
      return isSignedIn() && getUserData().role == 'customer';
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && 
             data.role in ['owner', 'worker', 'customer', 'admin'] &&
             (data.createdAt == request.time || data.createdAt.toMillis() > 0) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
             (!('photoUrl' in data) || (data.photoUrl is string || data.photoUrl == null)) &&
             (!('stationId' in data) || (data.stationId is string || data.stationId == null)) &&
             (!('credits' in data) || data.credits is number) &&
             (!('theme' in data) || data.theme in ['light', 'dark']) &&
             (!('status' in data) || data.status in ['active', 'suspended']) &&
             (!('plan' in data) || data.plan is string) &&
             (!('pricing' in data) || data.pricing is map) &&
             (!('vehicles' in data) || data.vehicles is list) &&
             (!('updatedAt' in data) || (data.updatedAt == request.time || data.updatedAt.toMillis() > 0));
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'businessId', 'stationId', 'slot', 'status', 'createdAt', 'vehicleInfo']) &&
             data.userId == request.auth.uid &&
             data.businessId is string &&
             data.stationId is string &&
             data.slot is timestamp &&
             data.status in ['pending', 'confirmed', 'completed', 'canceled'] &&
             data.vehicleInfo is string &&
             (data.createdAt == request.time || data.createdAt.toMillis() > 0);
    }


    // --- Match Blocks ---

    // Initial connection test
    match /test/{id} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read, list: if isSignedIn() && (
        isOwner(userId) || 
        isAdmin() || 
        (isStationOwner() && (resource.data.stationId == request.auth.uid || resource.data.uid == request.auth.uid)) ||
        (isWorker() && resource.data.stationId == getUserData().stationId) ||
        (resource == null || resource.data.phone != null) 
      );
      allow create: if isSignedIn() && (
        (isOwner(userId) && isValidUser(incoming())) ||
        // Auto-provisioned workers on first login
        (incoming().role == 'worker' && exists(/databases/$(database)/documents/authorized_workers/$(incoming().email)))
      );
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && 
                    incoming().uid == existing().uid &&
                    (
                      incoming().role == existing().role || 
                      (incoming().role == 'worker' && exists(/databases/$(database)/documents/authorized_workers/$(incoming().email)))
                    ) &&
                    isValidUser(incoming());
    }

    match /authorized_workers/{id} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.stationId || request.auth.token.email == resource.data.email || isAdmin());
      allow create, delete: if isSignedIn() && (isStationOwner() || isAdmin());
    }

    match /wash_businesses/{id} {
      allow read: if true;
      allow create: if isSignedIn() && (isStationOwner() || isAdmin()) && incoming().ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{id} {
      allow read: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow write: if isAdmin();
    }

    match /bookings/{id} {
      // Identity isolation
      allow read: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isOwner(resource.data.workerId) ||
        isStationMember(resource.data.stationId) ||
        isAdmin()
      );
      
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidBooking(incoming());
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isWorker() && resource.data.stationId == getUserData().stationId && incoming().status == 'completed' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'workerId'])) ||
        (isOwner(existing().userId) && incoming().status == 'canceled' && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        (isStationOwner() && resource.data.stationId == request.auth.uid)
      );
      
      allow delete: if isAdmin();
    }

    match /washes/{id} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.workerId) || 
        isStationMember(resource.data.stationId) ||
        isAdmin() || 
        isCustomer()
      );
      allow create: if isSignedIn() && (isStationMember(incoming().stationId) || isAdmin());
      allow update: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isAdmin();
    }

    match /incentives/{id} {
      // Allow workers to see their own incentives, and station owners/admins to see all for reports
      allow read: if isSignedIn() && (isOwner(resource.data.workerId) || isStationOwner() || isAdmin());
      // For MVP, allow workers to log their own job incentives as triggered in App.tsx
      allow create: if isSignedIn() && (isWorker() || isAdmin());
      allow delete: if isAdmin();
    }

    match /withdrawals/{id} {
      allow read: if isSignedIn() && (isOwner(resource.data.ownerId) || isAdmin());
      allow create: if isSignedIn() && isOwner(incoming().ownerId) && 
                    incoming().keys().hasAll(['ownerId', 'amount', 'bankName', 'status', 'timestamp']) &&
                    incoming().amount is number && incoming().amount > 0 &&
                    incoming().status == 'processed' &&
                    incoming().timestamp == request.time;
      allow delete: if isAdmin();
    }

    match /marketplace_items/{id} {
      allow read: if true;
      allow write: if isAdmin() || (isStationOwner() && (existing() == null || existing().ownerUid == request.auth.uid) && (incoming() == null || incoming().ownerUid == request.auth.uid));
    }

    match /orders/{id} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin() || (isStationOwner() && resource.data.businessId == get(/databases/$(database)/documents/wash_businesses/$(request.auth.uid)).id));
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isAdmin();
    }
  }
}
