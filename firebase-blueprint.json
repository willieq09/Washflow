{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information including role and display details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique identifier." },
        "name": { "type": "string", "description": "Display name of the user." },
        "email": { "type": "string", "description": "Email address of the user." },
        "phone": { "type": "string", "description": "Phone number for contact." },
        "role": { "type": "string", "enum": ["owner", "worker", "customer", "admin"], "description": "Role determining access levels." },
        "photoUrl": { "type": "string", "description": "Profile picture URL." },
        "status": { "type": "string", "enum": ["active", "suspended"], "description": "Account status." },
        "plan": { "type": "string", "description": "Active subscription plan ID or level." },
        "vehicles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "make": { "type": "string" },
              "model": { "type": "string" },
              "year": { "type": "number" },
              "plate": { "type": "string" },
              "intensity": { "type": "string", "enum": ["low", "high"] }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the user account was created." }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "WashBusiness": {
      "title": "Wash Business",
      "description": "Commercial car wash location details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "businessLat": { "type": "number" },
        "businessLng": { "type": "number" },
        "businessRadius": { "type": "number" }
      },
      "required": ["name", "ownerId", "status"]
    },
    "Plan": {
      "title": "Subscription Plan",
      "description": "Tiered subscription service levels.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "interval": { "type": "string", "enum": ["month", "year"] },
        "features": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean" }
      },
      "required": ["name", "price", "interval", "active"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Tracking of user payments and plan status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "planId": { "type": "string" },
        "providerRef": { "type": "string" },
        "state": { "type": "string", "enum": ["active", "past_due", "canceled"] }
      },
      "required": ["userId", "planId", "state"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Scheduled or completed wash service.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "vehicleId": { "type": "string" },
        "businessId": { "type": "string" },
        "workerId": { "type": "string" },
        "slot": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "canceled"] },
        "price": { "type": "number" },
        "maintenanceTip": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      },
      "required": ["userId", "vehicleId", "businessId", "slot", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback on a booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" }
      },
      "required": ["bookingId", "rating"]
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "UserProfile", "description": "User accounts." },
    "/wash_businesses/{id}": { "schema": "WashBusiness", "description": "Wash station locations." },
    "/plans/{id}": { "schema": "Plan", "description": "Subscription pricing." },
    "/subscriptions/{id}": { "schema": "Subscription", "description": "Active user memberships." },
    "/bookings/{id}": { "schema": "Booking", "description": "Service records (replacing /washes)." },
    "/reviews/{id}": { "schema": "Review", "description": "Customer feedback." },
    "/incentives/{id}": { "schema": "Incentive", "description": "Worker bonuses." }
  }
}
