{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information including role and display details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique identifier." },
        "name": { "type": "string", "description": "Display name of the user." },
        "email": { "type": "string", "description": "Email address of the user." },
        "phone": { "type": "string", "description": "Phone number for contact." },
        "role": { "type": "string", "enum": ["owner", "worker", "customer", "admin"], "description": "Role determining access levels." },
        "stationId": { "type": "string", "description": "ID of the station owner this user belongs to (for workers)." },
        "photoUrl": { "type": "string", "description": "Profile picture URL." },
        "status": { "type": "string", "enum": ["active", "suspended"], "description": "Account status." },
        "plan": { "type": "string", "description": "Active subscription plan ID or level." },
        "credits": { "type": "number", "description": "Remaining wash credits." },
        "pricing": {
          "type": "object",
          "properties": {
            "sedan": { "type": "number" },
            "suv": { "type": "number" },
            "truck": { "type": "number" }
          }
        },
        "vehicles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "make": { "type": "string" },
              "model": { "type": "string" },
              "year": { "type": "number" },
              "plate": { "type": "string" },
              "intensity": { "type": "string", "enum": ["low", "high"] },
              "tirePressure": { "type": "string" },
              "dirtLevel": { "type": "string", "enum": ["low", "medium", "high"] }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the user account was created." }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "WashBusiness": {
      "title": "Wash Business",
      "description": "Commercial car wash location details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "businessLat": { "type": "number" },
        "businessLng": { "type": "number" },
        "businessRadius": { "type": "number" },
        "pricing": {
          "type": "object",
          "properties": {
            "sedan": { "type": "number" },
            "suv": { "type": "number" },
            "truck": { "type": "number" }
          }
        },
        "qrCode": { "type": "string" }
      },
      "required": ["name", "ownerId", "status"]
    },
    "Plan": {
      "title": "Subscription Plan",
      "description": "Tiered subscription service levels.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "interval": { "type": "string", "enum": ["month", "year"] },
        "features": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean" }
      },
      "required": ["name", "price", "interval", "active"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Tracking of user payments and plan status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "planId": { "type": "string" },
        "providerRef": { "type": "string" },
        "state": { "type": "string", "enum": ["active", "past_due", "canceled"] }
      },
      "required": ["userId", "planId", "state"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Scheduled or completed wash service.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "vehicleId": { "type": "string" },
        "businessId": { "type": "string" },
        "stationId": { "type": "string" },
        "workerId": { "type": "string" },
        "slot": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "canceled"] },
        "price": { "type": "number" },
        "maintenanceTip": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      },
      "required": ["userId", "vehicleId", "businessId", "stationId", "slot", "status"]
    },
    "WashLog": {
      "title": "Wash Log",
      "description": "Historical record of a completed wash service.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "stationId": { "type": "string" },
        "carModel": { "type": "string" },
        "plateNumber": { "type": "string" },
        "price": { "type": "number" },
        "commission": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "maintenanceTip": { "type": "string" }
      },
      "required": ["workerId", "stationId", "carModel", "plateNumber", "price"]
    },
    "AuthorizedWorker": {
      "title": "Authorized Worker",
      "description": "Email whitelist for workers allowed to join a specific station.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "stationId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "stationId"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback on a booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" }
      },
      "required": ["bookingId", "rating"]
    },
    "MarketplaceItem": {
      "title": "Marketplace Item",
      "description": "Product or service listed in the marketplace.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string", "enum": ["accessory", "part", "service"] },
        "image": { "type": "string" },
        "ownerUid": { "type": "string" },
        "businessId": { "type": "string" },
        "vendor": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "ownerUid"]
    },
    "Order": {
      "title": "Order",
      "description": "Purchase record for marketplace items.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "paymentRef": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "itemId", "amount", "status"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "Owner fund extraction from platform balance.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "amount": { "type": "number" },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processed", "failed"] },
        "reference": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "amount", "bankName", "accountNumber", "accountName", "status"]
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "UserProfile", "description": "User accounts." },
    "/wash_businesses/{id}": { "schema": "WashBusiness", "description": "Wash station locations." },
    "/plans/{id}": { "schema": "Plan", "description": "Subscription pricing." },
    "/subscriptions/{id}": { "schema": "Subscription", "description": "Active user memberships." },
    "/bookings/{id}": { "schema": "Booking", "description": "Service records (replacing /washes)." },
    "/washes/{id}": { "schema": "WashLog", "description": "Completed service records." },
    "/authorized_workers/{id}": { "schema": "AuthorizedWorker", "description": "Staff provisioning whitelist." },
    "/reviews/{id}": { "schema": "Review", "description": "Customer feedback." },
    "/incentives/{id}": { "schema": "Incentive", "description": "Worker bonuses." },
    "/marketplace_items/{id}": { "schema": "MarketplaceItem", "description": "Product and services." },
    "/orders/{id}": { "schema": "Order", "description": "Transaction records." },
    "/withdrawals/{id}": { "schema": "Withdrawal", "description": "Owner cash-out records." }
  }
}
